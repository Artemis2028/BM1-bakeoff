{
  "name": "broken-mirror-1",
  "version": "0.0.1",
  "description": "A browser-playable remaster of FlashTrek: Broken Mirror 1 on the BM2 engine.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "build:python": "python3 scripts/build_release.py",
    "test:phase1": "node scripts/test-phase1-engine.mjs",
    "test:phase3": "node scripts/test-phase3-checkpoints.mjs",
    "test:phase4": "node scripts/test-phase4-incidents.mjs",
    "test:phase5": "node scripts/test-phase5-objectives.mjs",
    "test:phase6": "node scripts/test-phase6-sensors.mjs",
    "test:phase65": "node scripts/test-phase65-power-sensors.mjs",
    "test:phase7": "node scripts/test-phase7-fleet.mjs",
    "test:phase8": "node scripts/test-phase8-markets.mjs",
    "test:phase9": "node scripts/test-phase9-ew-weapons.mjs",
    "test:phase91": "node scripts/test-phase91-ew-robustness.mjs",
    "test:side-lane": "node scripts/test-side-lane-repair-reman.mjs && node scripts/test-side-lane-unrest-independence.mjs",
    "test:catalog": "node scripts/test-catalog-wire.mjs",
    "check:ship-manifest": "node scripts/sync-ship-roster.mjs --check",
    "test:ships": "node bm-ships/validate.mjs",
    "serve": "python3 -m http.server 8001",
    "test:doctrine": "python3 docs/doctrine/validate-doctrine.py && node scripts/test-doctrine-runtime.mjs",
    "probe": "node scripts/behavior-probe.mjs",
    "release:serve": "python3 -m http.server 8001 --directory dist",
    "clean": "rm -rf dist dist-chrome-extension"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
