+<script>const DATA=${JSON.stringify(data).replaceAll('<','\\u003c')};const $=id=>document.getElementById(id);const esc=s=>String(s??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');const n=x=>Number(x).toLocaleString('en-US');
